# Optional. If unset, a random one is generated on first run and persisted
# in the data volume/directory (survives restarts and rebuilds). Set it
# explicitly only if you need a multi-instance deploy sharing one secret.
# SESSION_SECRET=a-long-random-string

# Optional. Set this to get a clickable link in password-reset emails instead
# of a plain code to paste in — see "Password recovery" in the README.
# PUBLIC_URL=https://racktemp.example.lan

# Optional. How long reading history is kept before automatic pruning (days).
# READING_RETENTION_DAYS=90
