PORT=7431
DATABASE_URL="file:../data/db.sqlite"

# Optional. If unset, a random one is generated on first run and persisted
# in the data directory (survives restarts and rebuilds).
# SESSION_SECRET=a-long-random-string

# Optional. Set only if this instance sits behind a reverse proxy, to the
# number of hops between the client and this app (usually 1). Needed for
# rate limiting to see the real client IP instead of the proxy's.
# TRUST_PROXY_HOPS=1

# Optional. Set to 1 once there's an HTTPS reverse proxy in front of this
# instance, to mark the session cookie Secure (browser then refuses to send
# it over plain HTTP). Leave unset for a plain-HTTP LAN deploy. Not needed
# if you enabled HTTPS from Settings > Network instead (self-signed cert
# served by the app itself) — that already marks the cookie Secure on its own.
# COOKIE_SECURE=1

# Optional. How long a login session stays valid, in hours. Default 24.
# SESSION_MAX_AGE_HOURS=24

# Optional. How long security-relevant audit log entries (login attempts,
# credential/config changes) are kept before automatic pruning, in days.
# AUDIT_LOG_RETENTION_DAYS=365

# Optional, off by default. Set to 1 to check every new password (first
# login, change password, both reset flows) against the HaveIBeenPwned
# breach database before accepting it — k-anonymity range query, only the
# first 5 hex chars of the password's SHA1 hash ever leave this server, the
# password itself never does (see backend/src/services/pwnedPassword.ts).
# Off by default because this app is otherwise fully self-hosted with no
# required outbound internet access — turning this on means an outbound
# HTTPS call to api.pwnedpasswords.com on every password change. Leave
# unset on an air-gapped install or if you'd rather not make that call.
# HIBP_PASSWORD_CHECK=1
