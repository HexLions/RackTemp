PORT=7431
DATABASE_URL="file:../data/db.sqlite"

# Optional. If unset, a random one is generated on first run and persisted
# in the data directory (survives restarts and rebuilds).
# SESSION_SECRET=a-long-random-string

# Optional. Set only if this instance sits behind a reverse proxy, to the
# number of hops between the client and this app (usually 1). Needed for
# rate limiting to see the real client IP instead of the proxy's.
# TRUST_PROXY_HOPS=1

# Optional. Set to 1 once there's an HTTPS reverse proxy in front of this
# instance, to mark the session cookie Secure (browser then refuses to send
# it over plain HTTP). Leave unset for a plain-HTTP LAN deploy. Not needed
# if you enabled HTTPS from Settings > Network instead (self-signed cert
# served by the app itself) — that already marks the cookie Secure on its own.
# COOKIE_SECURE=1
