[Unit]
Description=RackTemp - rack temperature/humidity monitor
After=network.target

[Service]
Type=simple
User=racktemp
Group=racktemp
WorkingDirectory=/opt/racktemp/backend
# Stesso comando che gira nel container Docker a ogni avvio: crea/sincronizza
# le tabelle SQLite se mancano (idempotente). Senza, il servizio parte ma
# crasha subito con "table AdminUser does not exist" su un database nuovo.
ExecStartPre=/opt/racktemp/node/bin/node node_modules/prisma/build/index.js db push --skip-generate
ExecStart=/opt/racktemp/node/bin/node dist/index.js
Restart=on-failure
RestartSec=5
# Il servizio non ha bisogno di scrivere altro che qui dentro: dati e log.
ReadWritePaths=/var/lib/racktemp

[Install]
WantedBy=multi-user.target
